* text=auto eol=lf
*.bat text=auto eol=crlf

## Binary runtime assets (kept in plain git so builds and CI never need LFS)
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary
*.wav binary
*.ttf binary
*.otf binary
*.ico binary
*.icns binary
*.jar binary

## Source art and raw audio live in art-src/ and go through Git LFS
*.ase filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
art-src/**/*.png filter=lfs diff=lfs merge=lfs -text
art-src/**/*.wav filter=lfs diff=lfs merge=lfs -text
art-src/**/*.flac filter=lfs diff=lfs merge=lfs -text
